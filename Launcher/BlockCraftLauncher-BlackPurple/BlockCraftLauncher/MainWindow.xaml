<Window x:Class="BlockCraftLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlockCraft Launcher" Height="800" Width="1300"
        MinHeight="700" MinWidth="1080" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Storyboard x:Key="PageIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.32">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B8A9CC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBd" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBd" Property="Background" Value="#292039"/>
                                <Setter Property="Foreground" Value="#F4E9FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2EAFE"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="CardSurface" TargetType="Border">
            <Setter Property="Background" Value="#E9161122"/>
            <Setter Property="BorderBrush" Value="#49315F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#F4ECFF"/>
            <Setter Property="Background" Value="#211B35"/>
            <Setter Property="BorderBrush" Value="#65418C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                    <Grid>
                                        <ContentPresenter Margin="12,8,34,8" VerticalAlignment="Center"
                                                        HorizontalAlignment="Left" IsHitTestVisible="False"
                                                        Content="{TemplateBinding SelectionBoxItem}"
                                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                        ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                        <TextBlock Text="⌄" FontSize="17" Foreground="#C9A5EB"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,2"/>
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=DropDownToggle}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Background="#171222" BorderBrush="#65418C" BorderThickness="1"
                                        CornerRadius="10" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer CanContentScroll="True" MaxHeight="220">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem" x:Key="VersionCardItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="#171222" BorderBrush="#39264E" BorderThickness="1"
                                CornerRadius="13" Padding="16" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#9B5DE5"/>
                                <Setter TargetName="Card" Property="Background" Value="#21162F"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1.01" Duration="0:0:0.13"/>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1.01" Duration="0:0:0.13"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#C084FC"/>
                                <Setter TargetName="Card" Property="Background" Value="#38204F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="19" Background="#0B0812" BorderBrush="#65418C" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#F20D0A17" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="27" Height="27" CornerRadius="9" Background="#6732A0" Margin="0,0,10,0">
                        <TextBlock Text="◆" Foreground="#F2DEFF" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="BLOCKCRAFT" FontSize="13" FontWeight="ExtraBold" Foreground="#F7F0FF"/>
                    <TextBlock Text="  LAUNCHER" FontSize="10" FontWeight="Bold" Foreground="#A88BC5" VerticalAlignment="Center" Margin="8,1,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Ellipse Width="7" Height="7" Fill="#B879FF" Margin="0,0,8,0"/>
                    <TextBlock x:Name="HeaderStatus" Text="ГОТОВ К РАБОТЕ" Foreground="#CBA7F4" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <Button Content="—" Width="38" Height="30" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#C8B7D9" Click="Minimize_Click"/>
                    <Button Content="✕" Width="38" Height="30" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#C8B7D9" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#F20C0914" BorderBrush="#30213F" BorderThickness="0,0,1,0">
                    <Grid Margin="16,20,16,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" FontSize="10" FontWeight="Bold" Foreground="#806D96" Margin="9,0,0,12"/>
                            <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Background="#48266A" Foreground="White" Click="HomeNav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⌂" FontSize="21" Width="30"/>
                                    <TextBlock Text="Главная" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="LibraryNav" Style="{StaticResource NavButton}" Click="LibraryNav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◇" FontSize="20" Width="30" Foreground="#C084FC"/>
                                    <TextBlock Text="Библиотека" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="SkinsNav" Style="{StaticResource NavButton}" Click="SkinsNav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="☻" FontSize="19" Width="30" Foreground="#C084FC"/>
                                    <TextBlock Text="Скины" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="UpdateNav" Style="{StaticResource NavButton}" Click="UpdateNav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↑" FontSize="20" Width="30" Foreground="#C084FC"/>
                                    <TextBlock Text="Обновления" VerticalAlignment="Center"/>
                                    <Ellipse x:Name="UpdateDot" Width="8" Height="8" Fill="#FB7185" Margin="10,0,0,0"
                                             VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Click="SettingsBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="18" Width="30" Foreground="#C084FC"/>
                                    <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="4">
                            <Border Height="1" Background="#30213F" Margin="0,0,0,14"/>
                            <TextBlock Text="BLOCKCRAFT LAUNCHER" FontSize="10" Foreground="#88769B" FontWeight="Bold"/>
                            <TextBlock x:Name="VersionLabel" Text="Клиент" FontSize="11" Foreground="#6F607F" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="24,22,24,22">
                    <!-- HOME PAGE -->
                    <Grid x:Name="HomePage" Opacity="1" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" CornerRadius="20" BorderBrush="#8050B8" BorderThickness="1"
                                ClipToBounds="True" Margin="0,0,0,18">
                            <Grid>
                                <Image Source="Assets/launcher-hero.png" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <ScaleTransform x:Name="HeroScale"/>
                                    </Image.RenderTransform>
                                </Image>
                                <Border Background="#B5080612"/>
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#F6080612" Offset="0"/>
                                            <GradientStop Color="#B5080612" Offset="0.52"/>
                                            <GradientStop Color="#26080612" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Ellipse x:Name="GlowOrb" Width="470" Height="470" HorizontalAlignment="Right"
                                         VerticalAlignment="Top" Margin="0,-190,-110,0" Fill="#A855F7"
                                         Opacity="0.22" IsHitTestVisible="False">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="105"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Grid Margin="42,38">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel VerticalAlignment="Center" MaxWidth="650" HorizontalAlignment="Left">
                                        <TextBlock Text="BLOCKCRAFT • ТВОЙ МИР" FontSize="12" FontWeight="Bold"
                                                   Foreground="#D8B5FF"/>
                                        <TextBlock Text="Твой мир. Твои правила." FontSize="40" FontWeight="ExtraBold"
                                                   Foreground="White" Margin="0,14,0,0" TextWrapping="Wrap">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="#9D4EDD" BlurRadius="28"
                                                ShadowDepth="0" Opacity="0.42"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock Text="Выбирай сборку, запускай игру и создавай собственную историю."
                                                   FontSize="15" Foreground="#D3C5E2" TextWrapping="Wrap"
                                                   Margin="2,13,0,0"/>
                                    </StackPanel>
                                    <Grid Grid.Row="1" VerticalAlignment="Bottom">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PlayBtn" Content="▶   ИГРАТЬ" Style="{StaticResource EpicPlayButton}"
                                                Width="230" Height="64" FontSize="19" Click="PlayBtn_Click"/>
                                        <Border Grid.Column="1" Background="#E9171224" BorderBrush="#9566BB"
                                                BorderThickness="1" CornerRadius="13" Padding="18,11"
                                                Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="330"
                                                HorizontalAlignment="Left">
                                            <StackPanel>
                                                <TextBlock Text="ТЕКУЩАЯ СБОРКА" FontSize="10"
                                                           Foreground="#C4AED8" FontWeight="Bold"/>
                                                <TextBlock x:Name="SelectedInfo" Text="Загрузка версий..."
                                                           FontSize="16" Foreground="White" FontWeight="Bold"
                                                           Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Height="194">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="1.1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardSurface}" Padding="22" Margin="0,0,14,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◈" FontSize="20" Foreground="#C084FC" Margin="0,0,11,0"/>
                                        <TextBlock Text="ИГРОВОЙ ПРОФИЛЬ" FontSize="13" FontWeight="Bold"
                                                   Foreground="#F0E7FA" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <TextBlock Text="ТВОЙ НИКНЕЙМ" FontSize="11" Foreground="#B7A4CA"
                                                   FontWeight="Bold" Margin="1,0,0,8"/>
                                        <TextBox x:Name="NickBox" MaxLength="16" FontSize="16"
                                                 Padding="15,12" Height="48" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Text="Локальный профиль BlockCraft"
                                               FontSize="11" Foreground="#9B8BAC" Margin="1,8,0,0"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardSurface}" Padding="22">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✧" FontSize="20" Foreground="#C084FC" Margin="0,0,11,0"/>
                                        <TextBlock Text="ЦЕНТР УПРАВЛЕНИЯ" FontSize="13" FontWeight="Bold"
                                                   Foreground="#F0E7FA" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="ControlTitle" Text="Готов к запуску?"
                                                   FontSize="19" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock x:Name="ControlDescription"
                                                   Text="Выбери сборку и отправляйся исследовать мир."
                                                   FontSize="12" Foreground="#B7A8C8" TextWrapping="Wrap"
                                                   Margin="0,6,0,12"/>
                                        <ProgressBar x:Name="Bar" Height="8" Maximum="100" Value="0"/>
                                        <TextBlock x:Name="StatusLabel" Text="Подключаемся к серверу версий..."
                                                   FontSize="11" Foreground="#9B8BAC" Margin="1,8,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Button x:Name="FolderBtn" Content="▣  ПАПКА ИГРЫ" FontSize="12"
                                                Padding="15,10" Margin="0,0,10,0" Click="FolderBtn_Click"/>
                                        <Button x:Name="DeleteBtn" Content="УДАЛИТЬ СБОРКУ" FontSize="12"
                                                Padding="15,10" Foreground="#FDA4AF" Click="DeleteBtn_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- LIBRARY PAGE -->
                    <Grid x:Name="LibraryPage" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform Y="12"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="КОЛЛЕКЦИЯ BLOCKCRAFT" FontSize="11" FontWeight="Bold" Foreground="#B68AE2"/>
                            <TextBlock Text="Библиотека сборок" Style="{StaticResource SectionTitle}" FontSize="30" Margin="0,5,0,0"/>
                            <TextBlock Text="Выбери установленную сборку или найди новую версию." FontSize="14" Foreground="#A99AB9" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,22,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" FontSize="14" Padding="14,12" ToolTip="Поиск версии" TextChanged="SearchBox_TextChanged"/>
                            <ComboBox x:Name="FilterBox" Grid.Column="1" Margin="12,0,0,0" FontSize="13"
                                      Padding="12,9" MinHeight="46" Background="#211B35" Foreground="#F4ECFF"
                                      BorderBrush="#65418C" SelectedIndex="0" SelectionChanged="FilterBox_SelectionChanged">
                                <ComboBoxItem Content="Все сборки"/>
                                <ComboBoxItem Content="Установленные"/>
                                <ComboBoxItem Content="Не установленные"/>
                            </ComboBox>
                            <Button Grid.Column="2" Content="↻  Обновить" Margin="12,0,0,0" Padding="18,10" Click="RefreshBtn_Click"/>
                        </Grid>
                        <Border Grid.Row="2" Style="{StaticResource CardSurface}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="2,0,2,15">
                                    <TextBlock Text="ДОСТУПНЫЕ ВЕРСИИ" FontSize="11" FontWeight="Bold" Foreground="#BDA9D0"/>
                                    <TextBlock x:Name="VersionCount" DockPanel.Dock="Right" Text="0 сборок" FontSize="11" Foreground="#8E7DA0"/>
                                </DockPanel>
                                <ListBox x:Name="VersionsList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemContainerStyle="{StaticResource VersionCardItem}" SelectionChanged="VersionsList_SelectionChanged">
                                    <ListBox.HorizontalContentAlignment>Stretch</ListBox.HorizontalContentAlignment>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="78">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="Strip" Background="#4B3A63" CornerRadius="3"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#F6EEFF"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <Border x:Name="LatestBadge" Visibility="Collapsed" Background="#5A3287" CornerRadius="6"
                                                                Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="НОВАЯ" FontSize="9" FontWeight="Bold" Foreground="#F0D5FF"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock FontSize="12" Foreground="#A995BA" Margin="0,5,0,0">
                                                        <Run Text="{Binding Tag, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding DateText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <ProgressBar Height="5" Maximum="100" Margin="0,9,0,0" Value="{Binding Progress}"
                                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="13" Foreground="#D7C8E8"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Content="{Binding ActionText}" Padding="18,9" Margin="0,0,8,0"
                                                        VerticalAlignment="Center" Click="CardAction_Click"/>
                                                <Button Grid.Column="4" Content="Удалить" Padding="12,9" Foreground="#FDA4AF" VerticalAlignment="Center"
                                                        Click="CardDelete_Click"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter TargetName="Strip" Property="Background" Value="#A855F7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLatest}" Value="True">
                                                    <Setter TargetName="LatestBadge" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- SKINS PAGE -->
                    <Grid x:Name="SkinsPage" Visibility="Collapsed" Opacity="0" Background="Transparent" AllowDrop="True"
                          Drop="SkinsPage_Drop" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform Y="12"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="ВНЕШНИЙ ВИД" FontSize="11" FontWeight="Bold" Foreground="#B68AE2"/>
                            <TextBlock Text="Скины" Style="{StaticResource SectionTitle}" FontSize="30" Margin="0,5,0,0"/>
                            <TextBlock Text="PNG 64×64 или 64×32. Перетащи файл в окно или нажми «Загрузить скин»."
                                       FontSize="14" Foreground="#A99AB9" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardSurface}" Padding="18" Margin="0,0,16,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="2,0,2,15">
                                        <Button DockPanel.Dock="Right" Content="＋  Загрузить скин" Padding="16,9" Click="SkinUpload_Click"/>
                                        <TextBlock Text="МОИ СКИНЫ" FontSize="11" FontWeight="Bold" Foreground="#BDA9D0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ListBox x:Name="SkinsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="SkinsList_SelectionChanged">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="96">
                                                    <Grid Width="64" Height="64" HorizontalAlignment="Center">
                                                        <Image Source="{Binding Head}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                        <Image Source="{Binding Hat}" Margin="-4" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#E9DDF7" Margin="0,8,0,0"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="90"/>
                                                    <TextBlock x:Name="ActiveTag" Text="● АКТИВЕН" FontSize="9" FontWeight="Bold"
                                                               Foreground="#C084FC" HorizontalAlignment="Center" Margin="0,3,0,0"
                                                               Visibility="Hidden"/>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter TargetName="ActiveTag" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="SkinsEmpty" Grid.Row="1" Text="Скинов пока нет. Перетащи сюда PNG-файл."
                                               Foreground="#8E7DA0" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardSurface}" Padding="22">
                                <StackPanel x:Name="SkinPreviewPanel" Visibility="Collapsed">
                                    <TextBlock Text="ПРЕДПРОСМОТР" FontSize="11" FontWeight="Bold" Foreground="#BDA9D0"/>
                                    <TextBlock x:Name="SkinName" FontSize="19" FontWeight="Bold" Foreground="White" Margin="0,8,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Background="#120E1C" CornerRadius="12" Padding="14" Margin="0,14,0,0">
                                        <Image x:Name="SkinFull" Height="240" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>
                                    <TextBlock x:Name="SkinMeta" FontSize="11" Foreground="#9B8BAC" Margin="1,10,0,16"/>
                                    <Button x:Name="SkinApplyBtn" Style="{StaticResource EpicPlayButton}" Height="50" FontSize="14"
                                            Click="SkinApply_Click"/>
                                    <Button Content="УДАЛИТЬ СКИН" Foreground="#FDA4AF" Margin="0,10,0,0" Click="SkinDelete_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- UPDATE PAGE -->
                    <Grid x:Name="UpdatePage" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform Y="12"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="ЛАУНЧЕР" FontSize="11" FontWeight="Bold" Foreground="#B68AE2"/>
                            <TextBlock Text="Обновления" Style="{StaticResource SectionTitle}" FontSize="30" Margin="0,5,0,0"/>
                            <TextBlock x:Name="UpdateState" Text="Проверка ещё не выполнялась." FontSize="14" Foreground="#A99AB9" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource CardSurface}" Padding="24" Margin="0,22,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <StackPanel Margin="0,0,48,0">
                                        <TextBlock Text="ТЕКУЩАЯ ВЕРСИЯ" FontSize="10" FontWeight="Bold" Foreground="#88769B"/>
                                        <TextBlock x:Name="UpdateCurrent" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="ПОСЛЕДНЯЯ ВЕРСИЯ" FontSize="10" FontWeight="Bold" Foreground="#88769B"/>
                                        <TextBlock x:Name="UpdateLatest" Text="—" FontSize="22" FontWeight="Bold" Foreground="#D8B5FF" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="ЧТО НОВОГО" FontSize="11" FontWeight="Bold" Foreground="#BDA9D0" Margin="0,0,0,10"/>
                                    <TextBox x:Name="UpdateNotes" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="13"/>
                                </Grid>
                                <StackPanel Grid.Row="2" Margin="0,18,0,0">
                                    <ProgressBar x:Name="UpdateBar" Height="8" Maximum="100" Value="0" Margin="0,0,0,14"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="UpdateCheckBtn" Content="↻  Проверить обновления" Padding="18,12" Margin="0,0,12,0"
                                                Click="UpdateCheck_Click"/>
                                        <Button x:Name="UpdateApplyBtn" Content="ОБНОВИТЬ ЛАУНЧЕР" Style="{StaticResource EpicPlayButton}"
                                                Padding="26,12" FontSize="14" Visibility="Collapsed" Click="UpdateApply_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>