<Window x:Class="BlockCraftLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки BlockCraft" Height="700" Width="860"
        MinHeight="650" MinWidth="780" MaxHeight="980" MaxWidth="1200"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="20" Background="#0D0A16" BorderBrush="#68428F" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="30,26,28,22" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="ПАРАМЕТРЫ КЛИЕНТА" FontSize="12" FontWeight="Bold" Foreground="#B68AE2"/>
                    <TextBlock Text="Настройки" FontSize="32" FontWeight="Bold" Foreground="#F7F0FF" Margin="0,6,0,0"/>
                    <TextBlock Text="Настрой BlockCraft под себя." FontSize="15" Foreground="#A99AB9" Margin="0,6,0,0"/>
                </StackPanel>
                <Button Content="✕" Width="42" Height="40" Padding="0" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Background="#21182F" Click="Cancel_Click"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="28,0,28,18" Padding="2,4,10,8">
                <StackPanel>
                    <Border Background="#171222" BorderBrush="#49315F" BorderThickness="1"
                            CornerRadius="16" Padding="26">
                        <StackPanel>
                            <TextBlock Text="ПАПКА УСТАНОВКИ" FontSize="13" FontWeight="Bold" Foreground="#E0D1EF"/>
                            <TextBlock Text="Выбери расположение игровых файлов и установленных сборок."
                                       FontSize="14" Foreground="#A99AB9" Margin="0,8,0,18" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="DirBox" FontSize="14" Padding="16,13" MinHeight="50"
                                         VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="Обзор папок" Margin="14,0,0,0"
                                        Padding="22,12" MinHeight="50" FontSize="14" Click="Browse_Click"/>
                            </Grid>
                            <TextBlock Text="Уже установленные версии при смене папки автоматически не переносятся."
                                       FontSize="12" Foreground="#9385A3" TextWrapping="Wrap" Margin="2,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#171222" BorderBrush="#49315F" BorderThickness="1"
                            CornerRadius="16" Padding="26" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="ПОВЕДЕНИЕ ЛАУНЧЕРА" FontSize="13" FontWeight="Bold" Foreground="#E0D1EF"/>
                            <TextBlock Text="Управление поведением клиента после запуска игры."
                                       FontSize="14" Foreground="#A99AB9" Margin="0,8,0,16"/>
                            <CheckBox x:Name="CloseCheck" Content="Закрывать лаунчер после запуска Minecraft"
                                      Foreground="#F0E7FA" FontSize="15" Margin="0,2,0,7" Padding="2,5"/>
                            <TextBlock Text="Если опция отключена, лаунчер останется открытым во время игры."
                                       FontSize="12" Foreground="#9385A3" TextWrapping="Wrap" Margin="2,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Background="#F20D0A16" BorderBrush="#30213F"
                    BorderThickness="0,1,0,0" Padding="26,17">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Width="124" Height="48" Margin="0,0,14,0"
                            FontSize="14" Click="Cancel_Click"/>
                    <Button Content="Сохранить изменения" Width="210" Height="48"
                            Style="{StaticResource EpicPlayButton}" FontSize="14"
                            Padding="14,10" Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
